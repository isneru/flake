diff --git a/docs/wmenu.1.scd b/docs/wmenu.1.scd
index 3080be2..6733b49 100644
--- a/docs/wmenu.1.scd
+++ b/docs/wmenu.1.scd
@@ -6,7 +6,7 @@ wmenu - dynamic menu for Wayland
 
 # SYNOPSIS
 
-*wmenu* [-biPv] \
+*wmenu* [-biPRv] \
   [-f _font_] \
   [-l _lines_] \
   [-o _output_] \
@@ -40,6 +40,11 @@ $PATH and runs the result.
 	wmenu will not directly display the keyboard input, but instead replace it
 	with asterisks.
 
+*-R*
+	lists items as a fixed readout rather than choices: every item is shown in
+	input order whatever is typed, none can be selected, and Return always
+	prints the typed text.
+
 *-v*
 	prints version information to stdout, then exits.
 
