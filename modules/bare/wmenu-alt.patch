@@ -6,7 +6,7 @@ wmenu - dynamic menu for Wayland
 
 # SYNOPSIS
 
-*wmenu* [-biPRv] \
+*wmenu* [-AbiPRv] \
   [-f _font_] \
   [-l _lines_] \
   [-o _output_] \
@@ -30,6 +30,11 @@ $PATH and runs the result.
 
 # OPTIONS
 
+*-A*
+	Shift+Return prints the selected item instead of the typed text and exits
+	with status 10, so a caller can tell it from Return. With nothing selected
+	it prints the typed text as usual.
+
 *-b*
 	wmenu appears at the bottom of the screen.
 
