+// Returns the width a centered menu should ask for: wide enough for the
+// prompt and the widest item, clamped to a band of the output's own width.
+int context_content_width(struct wl_context *context) {
+	struct menu *menu = context->menu;
+	struct output *output = context->output ? context->output : context->output_list;
+
+	calc_widths(menu);
+
+	int width = menu->promptw + menu->inputw + 4 * menu->padding;
+	if (menu->lines > 0) {
+		width += menu->left_arrow + menu->right_arrow;
+	}
+
+	int scale = output && output->scale > 0 ? output->scale : 1;
+	int screen = output ? output->width / scale : 0;
+	if (screen <= 0) {
+		return width;
+	}
+
+	int min = screen * 3 / 10;
+	int max = screen * 3 / 5;
+	if (menu->preview_dir) {
+		// The preview column is a third of the box, so the rows keep their
+		// share only if the box itself grows.
+		width = width * 3 / 2;
+		max = screen * 4 / 5;
+	}
+	if (width < min) {
+		width = min;
+	}
+	if (width > max) {
+		width = max;
+	}
+	return width;
+}
