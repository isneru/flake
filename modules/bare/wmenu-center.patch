 // Connect to the Wayland display and run the menu.
 int menu_run(struct menu *menu) {
+	// -l is a maximum, not a fixed height: a list shorter than it shrinks the
+	// box to fit rather than padding it with empty rows. Items are known by now,
+	// which they are not when menu_getopts computes the initial height.
+	if (menu->lines > 0 && (size_t)menu->lines > menu->item_count) {
+		menu->lines = (int)menu->item_count;
+		menu->height = menu->line_height * (menu->lines + 1);
