+// Converts a pixbuf into a cairo image surface with premultiplied alpha.
+static cairo_surface_t *surface_from_pixbuf(GdkPixbuf *pixbuf) {
+	int w = gdk_pixbuf_get_width(pixbuf);
+	int h = gdk_pixbuf_get_height(pixbuf);
+	int channels = gdk_pixbuf_get_n_channels(pixbuf);
+	int src_stride = gdk_pixbuf_get_rowstride(pixbuf);
+	const unsigned char *src = gdk_pixbuf_get_pixels(pixbuf);
+
+	cairo_surface_t *surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, w, h);
+	if (cairo_surface_status(surface) != CAIRO_STATUS_SUCCESS) {
+		cairo_surface_destroy(surface);
+		return NULL;
+	}
+
+	unsigned char *dst = cairo_image_surface_get_data(surface);
+	int dst_stride = cairo_image_surface_get_stride(surface);
+	for (int y = 0; y < h; y++) {
+		uint32_t *row = (uint32_t *)(dst + (ptrdiff_t)y * dst_stride);
+		const unsigned char *in = src + (ptrdiff_t)y * src_stride;
+		for (int x = 0; x < w; x++) {
+			uint32_t r = in[x * channels + 0];
+			uint32_t g = in[x * channels + 1];
+			uint32_t bl = in[x * channels + 2];
+			uint32_t a = channels == 4 ? in[x * channels + 3] : 255;
+			r = r * a / 255;
+			g = g * a / 255;
+			bl = bl * a / 255;
+			row[x] = (a << 24) | (r << 16) | (g << 8) | bl;
+		}
+	}
+	cairo_surface_mark_dirty(surface);
+	return surface;
+}
+
+// Loads the preview image for an item, caching the last one loaded.
+static void load_preview(struct menu *menu, const char *name, int box_height) {
+	if (menu->preview_name && strcmp(menu->preview_name, name) == 0) {
+		return;
+	}
+
+	free(menu->preview_name);
+	menu->preview_name = strdup(name);
+	if (menu->preview_image) {
+		cairo_surface_destroy(menu->preview_image);
+		menu->preview_image = NULL;
+	}
+
+	char path[PATH_MAX];
+	int n = snprintf(path, sizeof(path), "%s/%s", menu->preview_dir, name);
+	if (n < 0 || (size_t)n >= sizeof(path)) {
+		return;
+	}
+
+	GdkPixbuf *pixbuf = gdk_pixbuf_new_from_file_at_scale(
+		path, menu->previeww, box_height, TRUE, NULL);
+	if (!pixbuf) {
+		return;
+	}
+	menu->preview_image = surface_from_pixbuf(pixbuf);
+	g_object_unref(pixbuf);
+}
+
+// Renders the preview image for the selected item.
+static void render_preview(struct menu *menu, cairo_t *cairo) {
+	if (menu->previeww <= 0 || !menu->sel) {
+		return;
+	}
+
+	int box_height = menu->height - menu->line_height;
+	load_preview(menu, menu->sel->text, box_height);
+	if (!menu->preview_image) {
+		return;
+	}
+
+	int iw = cairo_image_surface_get_width(menu->preview_image);
+	int ih = cairo_image_surface_get_height(menu->preview_image);
+	int x = menu->width - menu->previeww + (menu->previeww - iw) / 2;
+	int y = menu->line_height + (box_height - ih) / 2;
+
+	cairo_save(cairo);
+	cairo_set_operator(cairo, CAIRO_OPERATOR_OVER);
+	cairo_set_source_surface(cairo, menu->preview_image, x, y);
+	cairo_paint(cairo);
+	cairo_restore(cairo);
+}
