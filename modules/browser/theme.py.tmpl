c.colors.tooltip.bg = "{{bgDim}}"
c.colors.tooltip.fg = "{{fg}}"


_mode = ""
try:
    _state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    _mode = pathlib.Path(_state, "quickshell", "mode").read_text().strip()
except OSError:
    pass

if _mode == "bare":
    c.statusbar.show = "never"
    c.colors.statusbar.normal.bg = "#e0{{bgDimHex}}"
    c.colors.statusbar.command.bg = "#e0{{bgAltHex}}"
    c.colors.statusbar.command.private.bg = "#e0{{bgAltHex}}"
    c.colors.statusbar.private.bg = "#e0{{bgAltHex}}"
    c.colors.statusbar.insert.bg = "#e0{{successHex}}"
    c.colors.statusbar.passthrough.bg = "#e0{{infoHex}}"
    c.colors.statusbar.caret.bg = "#e0{{warningHex}}"
    c.colors.statusbar.caret.selection.bg = "#e0{{accentHex}}"
