}
for i, colour in ipairs(ansi) do
  vim.g["terminal_color_" .. (i - 1)] = colour
end

local function llmode(colour)
  return {
    a = { bg = "NONE", fg = colour, gui = "bold" },
    b = { bg = "NONE", fg = colour },
    c = { bg = "NONE", fg = c.fgDim },
  }
end

local lltheme = {
  normal = llmode(c.accent),
  insert = llmode(c.success),
  visual = llmode(c.brightMagenta),
  replace = llmode(c.error),
  command = llmode(c.warning),
  terminal = llmode(c.info),
  inactive = {
    a = { bg = "NONE", fg = c.fgMuted },
    b = { bg = "NONE", fg = c.fgMuted },
    c = { bg = "NONE", fg = c.fgMuted },
  },
}

local ok, lualine = pcall(require, "lualine")
if ok then
  local cfg = lualine.get_config()
  cfg.options.theme = lltheme
  lualine.setup(cfg)
end

vim.api.nvim_exec_autocmds("ColorScheme", { pattern = "theme-engine", modeline = false })
