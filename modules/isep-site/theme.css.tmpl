@font-face {
  font-family: "{{mono}}";
  src: url("fonts/{{mono}}-Regular.woff2") format("woff2");
  font-display: block;
}
@font-face {
  font-family: "{{mono}}";
  font-weight: 700;
  src: url("fonts/{{mono}}-Bold.woff2") format("woff2");
  font-display: block;
}
@font-face {
  font-family: "{{chrome}}";
  src: url("fonts/{{chrome}}-Regular.woff2") format("woff2");
  font-display: block;
}
:root {
  color-scheme: {{scheme}};
  --mono: "{{mono}}";
  --chrome: "{{chrome}}";
  --bg: {{bg}};
  --side: {{bgDim}};
  --raise: {{bgAlt}};
  --line: {{border}};
  --fg: {{fg}};
  --soft: {{fgDim}};
  --muted: {{fgMuted}};
  --accent: {{accent}};
  --keyword: {{magenta}};
  --string: {{green}};
  --number: {{yellow}};
  --func: {{blue}};
  --type: {{cyan}};
}
